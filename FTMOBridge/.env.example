# Copy this file to .env and fill in real values. Never commit .env itself.

# Liquidity Lab API (defaults to production, no need to change)
LLAB_API_BASE=https://liquidity-lab-api.onrender.com

# MetaApi (metaapi.cloud) - connect your FTMO demo account's MT4/MT5 login
# there first, then paste the resulting token and account id here.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# FTMO demo account parameters
ACCOUNT_SIZE=100000
MAX_RISK_PCT=0.01
DAILY_LOSS_LIMIT_PCT=0.05
MAX_DRAWDOWN_PCT=0.10
CIRCUIT_BREAKER_BUFFER=0.8

# Polling cadence (seconds)
POLL_INTERVAL_SECONDS=20
POSITION_POLL_INTERVAL_SECONDS=60
