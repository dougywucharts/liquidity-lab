# Liquidity Lab's public /events feed - same default as the other bridges.
LLAB_API_BASE=https://liquidity-lab-api.onrender.com

# From PickMyTrade: Generate Alert -> MATCHTRADER / STRATEGY / CFD /
# "Attach SL/TP to Orders" / PRICE (From TradingView) mode -> Copy Webhook
# URL, and the "token" field from the generated JSON. Never commit these.
PICKMYTRADE_WEBHOOK_URL=
PICKMYTRADE_TOKEN=

# From the "multiple_accounts" block of that same generated alert - the
# CFT/Match-Trader account this executes against. Account 400251 (eval
# #1, MATCHTRADER1) failed its evaluation 2026-08-21 - switched to a new
# eval account (400470, MATCHTRADER2) same day.
MATCHTRADER_CONNECTION_NAME=MATCHTRADER2
MATCHTRADER_ACCOUNT_ID=400470

# Fixed dollar amount to risk per real order - deliberately NOT a
# percentage of account balance, same reasoning as BlofinBridge.
RISK_AMOUNT_USD=25

# Skip signals older than this by the time we'd place the order.
MAX_SIGNAL_AGE_SECONDS=300

# Dropped from 20 -> 3 on 2026-08-21: real signal-to-send latency across
# all 46 live trades measured 70-131s, and this poll interval was up to
# 20s of that on its own. The bigger remaining pieces (candle-close lag
# inherent to 1m bars, and BOTFINAL.py's ~28s sequential scan loop) are
# separate, larger changes - this is just the free part.
POLL_INTERVAL_SECONDS=3
