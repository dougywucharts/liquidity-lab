generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  logs               TradeLog[]
  stripeCustomerId   String?      @unique
  stripeSubId        String?      @unique
  stripePriceId      String?
  stripeStatus       String?      // active, trialing, past_due, canceled, unpaid, incomplete
  billingStatus      String?
  billingPlan        String?      // starter, core, pro
  billingPeriodEnd   DateTime?
  founderMember      Boolean      @default(false)
  promoCodeUsed      String?
  isActive           Boolean      @default(false)
  isBetaUser         Boolean      @default(false)
  betaGrantedAt      DateTime?
  screenshotCount    Int          @default(0)
  screenshotReset    DateTime?
  aiReviewCount      Int          @default(0)
  aiReviewReset      DateTime?
  traderDna           Json?
  traderDnaGeneratedAt DateTime?
}

model TradeLog {
  id                  String    @id @default(cuid())
  userId              String

  pair                String?
  timeframe           String?
  session             String?
  action              String?
  pnl                 Float?
  notes               String?
  leverage            Float?

  entry               Float?
  stop                Float?
  exit                Float?
  tp1                 Float?
  tp2                 Float?
  rr1                 Float?
  rr2                 Float?

  directionBias       String?
  eventType           String?
  sweepType           String?
  emaContext          String?
  reclaimConfirmed    Boolean?
  planFollowed        String?
  ruleBreak           String?

  executionType       String?
  liquidityLevel      String?
  htfBias             String?
  entryTrigger        String?
  outcome             String?
  confidenceSelf      Float?
  durationMinutes     Float?
  realizedRR          Float?

  emotionalPressure   Float?
  setupQuality        Float?
  disciplineScore     Float?
  linkedEventId       String?

  screenshotUrl       String?

  aiScore             Int?
  aiGrade             String?
  aiSummary           String?
  aiCoachingNote      String?
  aiStatus            String?
  aiVerdict           String?
  aiComparison        String?
  aiStrengths         Json?
  aiMistakes          Json?

  tradeScore          Int?
  scoreNotes          String?

  setupScore          Int?
  executionScore      Int?
  managementScore     Int?
  disciplineScoreAi   Int?
  aiConfidence        Float?

  chartRead           String?
  setupAssessment     String?
  executionAssessment String?
  riskAssessment      String?
  biasAlignment       String?

  mistakeTags         Json?
  whatWasGood         Json?
  whatNeedsWork       Json?
  usedScreenshot      Boolean?
  aiPayload           Json?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RadarEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  // Core signal fields — indexed for fast lookup
  pair          String
  timeframe     String?
  eventType     String?
  directionBias String?
  sweepType     String?
  session       String?
  timestampUtc  String?

  // Price levels
  entry         Float?
  stop          Float?
  tp1           Float?
  tp2           Float?
  rr1           Float?
  rr2           Float?

  // Signal metadata
  botConfidence Float?
  tradeState    String?
  pattern       String?

  // Full payload stored as JSON for future use (analytics, AI archive)
  payload       Json

  @@index([createdAt])
  @@index([pair, createdAt])
  @@index([eventType, createdAt])
}
