generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  logs               TradeLog[]
  stripeCustomerId   String?      @unique
  stripeSubId        String?      @unique
  stripePriceId      String?
  stripeStatus       String?      // active, trialing, past_due, canceled, unpaid, incomplete
  billingStatus      String?
  billingPlan        String?      // starter, core, pro
  billingPeriodEnd   DateTime?
  founderMember      Boolean      @default(false)
  promoCodeUsed      String?
  isActive           Boolean      @default(false)
  isBetaUser         Boolean      @default(false)
  betaGrantedAt      DateTime?
  screenshotCount    Int          @default(0)
  screenshotReset    DateTime?
  aiReviewCount      Int          @default(0)
  aiReviewReset      DateTime?
  traderDna           Json?
  traderDnaGeneratedAt DateTime?
  resetPasswordToken     String?   @unique
  resetPasswordExpiresAt DateTime?
  pushTokens             Json?     // [{ token, addedAt, platform }] — supports multiple devices
  notificationsEnabled   Boolean   @default(false)
  notificationWatchlist  Json?     // up to 3 pair strings, e.g. ["BTC/USDT","ETH/USDT"]
  notificationPatterns   Json?     // subset of pattern names, e.g. ["Sweep + Retest"] — empty/null = any pattern
}

model TradeLog {
  id                  String    @id @default(cuid())
  userId              String

  pair                String?
  timeframe           String?
  session             String?
  action              String?
  pnl                 Float?
  notes               String?
  leverage            Float?

  entry               Float?
  stop                Float?
  exit                Float?
  tp1                 Float?
  tp2                 Float?
  rr1                 Float?
  rr2                 Float?

  directionBias       String?
  eventType           String?
  sweepType           String?
  emaContext          String?
  reclaimConfirmed    Boolean?
  planFollowed        String?
  ruleBreak           String?

  executionType       String?
  liquidityLevel      String?
  htfBias             String?
  entryTrigger        String?
  outcome             String?
  confidenceSelf      Float?
  durationMinutes     Float?
  realizedRR          Float?

  emotionalPressure   Float?
  setupQuality        Float?
  disciplineScore     Float?
  linkedEventId       String?

  screenshotUrl       String?

  aiScore             Int?
  aiGrade             String?
  aiSummary           String?
  aiCoachingNote      String?
  aiStatus            String?
  aiVerdict           String?
  aiComparison        String?
  aiStrengths         Json?
  aiMistakes          Json?

  tradeScore          Int?
  scoreNotes          String?

  setupScore          Int?
  executionScore      Int?
  managementScore     Int?
  disciplineScoreAi   Int?
  aiConfidence        Float?

  chartRead           String?
  setupAssessment     String?
  executionAssessment String?
  riskAssessment      String?
  biasAlignment       String?

  mistakeTags         Json?
  whatWasGood         Json?
  whatNeedsWork       Json?
  usedScreenshot      Boolean?
  aiPayload           Json?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RadarEvent {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())

  // Core signal fields — indexed for fast lookup
  pair          String
  timeframe     String?
  eventType     String?
  directionBias String?
  sweepType     String?
  session       String?
  timestampUtc  String?

  // Price levels
  entry         Float?
  stop          Float?
  tp1           Float?
  tp2           Float?
  rr1           Float?
  rr2           Float?

  // Signal metadata
  botConfidence Float?
  tradeState    String?
  pattern       String?

  // Outcome tracking — set by the bot once price resolves the signal
  outcome       String?  @default("PENDING") // PENDING | TP1_HIT | TP2_HIT | STOPPED | EXPIRED
  outcomeAt     DateTime?
  outcomePrice  Float?

  // Shadow signals: would have posted but got suppressed (confidence floor,
  // disabled event type). Tracked for outcome the same as real signals, but
  // never shown in the live feed - lets us prove a filter earns its keep
  // with real counterfactual data instead of assuming.
  shadow        Boolean  @default(false)

  // Set once this event's resolved outcome has been replayed into an
  // FtmoSimAccount, so the periodic sim job never double-applies a row.
  ftmoAppliedAt DateTime?

  // Full payload stored as JSON for future use (analytics, AI archive)
  payload       Json

  @@index([createdAt])
  @@index([pair, createdAt])
  @@index([eventType, createdAt])
  @@index([outcome])
  @@index([shadow])
}

// A single simulated $100k FTMO-rules account, replaying real RadarEvent
// outcomes (the "golden" filter's population) chronologically to see
// whether the edge survives FTMO's daily-loss/drawdown/profit-target rules
// - no broker involved, since we already track real win/loss/R-multiple
// outcomes for every signal. When one attempt PASSES or FAILS, the next
// RadarEvent processed opens a fresh attempt automatically, mirroring how a
// real trader would buy the next challenge - so this is a running series,
// not a single one-shot data point.
model FtmoSimAccount {
  id               String    @id @default(cuid())
  attemptNumber    Int
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  status           String    @default("ACTIVE") // ACTIVE | PASSED | FAILED

  startBalance     Float
  currentBalance   Float

  // Rolling daily-loss tracking. currentDay/dayStartBalance reset whenever
  // an applied event's UTC date differs from currentDay - same rolling-
  // field idiom as User.screenshotCount/screenshotReset.
  dayStartBalance  Float
  currentDay       String

  // Distinct UTC days with >=1 applied trade, for the minTradingDays rule.
  tradingDaysCount Int       @default(0)
  lastTradingDay   String?

  // Rule params used for THIS attempt, copied from PROP_PRESETS.ftmo_like
  // at creation time so a future rule tweak doesn't rewrite closed attempts.
  profitTargetPct  Float
  dailyLossPct     Float
  maxDrawdownPct   Float
  minTradingDays   Int
  riskPct          Float

  failReason       String?

  trades           FtmoSimTrade[]

  @@index([status])
  @@index([attemptNumber])
}

// One applied RadarEvent outcome against a FtmoSimAccount - the replayable
// trade log (Postgres equivalent of what ftmo_executor.py would have
// written to CSV against a real broker).
model FtmoSimTrade {
  id             String   @id @default(cuid())
  accountId      String
  account        FtmoSimAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  radarEventId   String
  eventCreatedAt DateTime // original signal's createdAt, for ordering/audit

  pair           String
  direction      String?
  session        String?
  pattern        String?

  realizedR      Float
  riskAmount     Float
  pnl            Float
  balanceAfter   Float

  appliedAt      DateTime @default(now())

  @@index([accountId])
  @@index([radarEventId])
}
