# Copy this file to .env and fill in real values. Never commit .env itself.

# Liquidity Lab API (defaults to production, no need to change)
LLAB_API_BASE=https://liquidity-lab-api.onrender.com

# BloFin DEMO trading API key - generate this from BloFin's "Demo Trading"
# section (NOT your live account's key). Requires trading permission.
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_API_PASSWORD=

# Fraction of BloFin's own ~5,000 USDT demo balance to risk per real order.
# Independent of the $100k PF ledger below - see blofin_executor.py's
# module docstring for why these are decoupled.
DEMO_RISK_PCT=0.01

# The $100k virtual FTMO-rules ledger (matches PROP_PRESETS.ftmo_like in
# src/App.jsx and the FTMO simulator in Server/server.js), run as SEVERAL
# parallel ledgers at different risk-per-trade levels (basis points), all
# fed the same real executed R-multiple per trade for direct comparison.
PF_ACCOUNT_SIZE=100000
PF_RISK_LEVELS_BPS=50,100,150,250
PF_PROFIT_TARGET_PCT=0.10
PF_DAILY_LOSS_PCT=0.05
PF_MAX_DRAWDOWN_PCT=0.10
PF_MIN_TRADING_DAYS=4

# Polling cadence (seconds)
POLL_INTERVAL_SECONDS=20
POSITION_POLL_INTERVAL_SECONDS=60
